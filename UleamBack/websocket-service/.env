# ===================================
# CONFIGURACIÓN COMPARTIDA - CRÍTICO
# ===================================
# IMPORTANTE: Este JWT_SECRET debe ser IDÉNTICO al del auth-service
JWT_SECRET=mi-secreto-auth-service-super-seguro-2025

# ===================================
# INTEGRACIÓN CON AUTH SERVICE (P2)
# ===================================
# URL del servicio de autenticación
AUTH_SERVICE_URL=http://localhost:9000
AUTH_VALIDATE_ENDPOINT=/api/v1/auth/validate
AUTH_PUBLIC_KEY_ENDPOINT=/api/v1/auth/public-key

# ===================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DATABASE=reservasuleam

# ===================================
# CONFIGURACIÓN DEL SERVIDOR
# ===================================
PORT=3001
NODE_ENV=development

# ===================================
# WEBSOCKET CONFIGURATION
# ===================================
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Tiempo de timeout para conexiones (ms)
SOCKET_TIMEOUT=60000

# Habilitar transporte de polling (además de websocket)
TRANSPORT_POLLING=true

# ===================================
# INTEGRACIÓN CON OTROS SERVICIOS
# ===================================
REST_SERVICE_URL=http://localhost:8000
GRAPHQL_URL=http://localhost:8081/graphql

# ===================================
# REDIS (Para Pub/Sub y caché)
# ===================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# ===================================
# LOGGING
# ===================================
LOG_LEVEL=debug