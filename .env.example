# ==========================================================
# ReservasUleam - Configuración central de Docker Compose
# Copiar a .env y completar los valores marcados con <...>
# ==========================================================

# ==========================================================
# GENERAL
# ==========================================================
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================================
# PUERTOS EXPUESTOS EN EL HOST (familia *4, no estándar)
# ==========================================================
FRONTEND_PORT=8084
AUTH_PORT=3004
REST_PORT=8004
GRAPHQL_PORT=8014
AI_PORT=5004
PAYMENT_PORT=8024
WEBSOCKET_PORT=3014
POSTGRES_PORT=5434
REDIS_PORT=6389
N8N_PORT=5684

# ==========================================================
# BASE DE DATOS (PostgreSQL 16)
# ==========================================================
POSTGRES_USER=Reservas_ULEAM
POSTGRES_PASSWORD=<contrasena-local-fuerte>
POSTGRES_DB=reservasuleam

# Nombres de las bases por dominio
DB_CORE=reservasuleam
DB_AI=ai_service_db
DB_PAYMENT=payment_service_db

# Conexión interna (host 'postgres' = nombre del servicio en Docker)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=Reservas_ULEAM
DB_USER=Reservas_ULEAM
DB_NAME=reservasuleam
DB_PASSWORD=<misma-que-POSTGRES_PASSWORD>

DATABASE_URL=postgresql+psycopg://Reservas_ULEAM:<password>@postgres:5432/reservasuleam
GRAPHQL_DATABASE_URL=postgres://Reservas_ULEAM:<password>@postgres:5432/reservasuleam?sslmode=disable
AI_DATABASE_URL=postgresql+psycopg://Reservas_ULEAM:<password>@postgres:5432/ai_service_db
PAYMENT_DATABASE_URL=postgresql+psycopg://Reservas_ULEAM:<password>@postgres:5432/payment_service_db

# ==========================================================
# SEGURIDAD / JWT (el MISMO valor en todos los servicios)
# ==========================================================
JWT_SECRET=<generar-con-openssl-rand-hex-32>
SECRET_KEY=<mismo-valor-que-JWT_SECRET>
JWT_ALGORITHM=HS256
ALGORITHM=HS256
JWT_EXPIRATION=15m
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRATION=7d
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Secretos de comunicación interna entre servicios
INTERNAL_PROVISION_TOKEN=<secreto-interno-auth-a-rest>
RESERVAS_INTERNAL_TOKEN=<secreto-interno-payment-a-rest>

# ==========================================================
# REDIS
# ==========================================================
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==========================================================
# URLS INTERNAS ENTRE SERVICIOS (red de Docker)
# ==========================================================
AUTH_SERVICE_URL=http://auth-service:9000
REST_SERVICE_URL=http://rest-service:8000
GRAPHQL_SERVICE_URL=http://graphql-service:8081
AI_SERVICE_URL=http://ai-service:5000
PAYMENT_SERVICE_URL=http://payment-service:8001
WEBSOCKET_SERVICE_URL=http://websocket-service:3001
AUTH_VALIDATE_ENDPOINT=/api/v1/auth/validate
AUTH_PUBLIC_KEY_ENDPOINT=/api/v1/auth/public-key

# ==========================================================
# CORS (orígenes del navegador = puertos del HOST)
# ==========================================================
CORS_ORIGIN=http://localhost:8084
CORS_ORIGINS=http://localhost:8084

# ==========================================================
# FRONTEND (inyectadas por Vite en build-time)
# ==========================================================
VITE_REST_BASE_URL=http://localhost:8004
VITE_AUTH_BASE_URL=http://localhost:3004
VITE_GRAPHQL_URL=http://localhost:8014/graphql
VITE_WS_URL=http://localhost:3014
VITE_AI_SERVICE_URL=http://localhost:5004
VITE_PAYMENT_BASE_URL=http://localhost:8024

# ==========================================================
# AI SERVICE (proveedores LLM)
# ==========================================================
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=<tu-api-key-de-groq>
GEMINI_API_KEY=<tu-api-key-de-gemini>
MAX_FILE_SIZE_MB=10
API_PREFIX=api/v1

# ==========================================================
# PAYMENT SERVICE
# ==========================================================
MOCK_PROVIDER_ENABLED=true
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
WEBHOOK_MAX_RETRIES=3
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ==========================================================
# N8N (orquestación de flujos)
# ==========================================================
N8N_WEBHOOK_URL=http://n8n:5678/webhook
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<contrasena-n8n>
GENERIC_TIMEZONE=America/Guayaquil

# ==========================================================
# INTEGRACION B2B - EQUIPO A (Recomendaciones Turisticas)
# Opcional: si EQUIPO_A_SHARED_SECRET esta vacio, los endpoints
# /api/v1/equipo-a/* responden 503 y la integracion queda apagada.
# ==========================================================
EQUIPO_A_SHARED_SECRET=<secreto-HMAC-acordado-con-equipo-a>
EQUIPO_A_WEBHOOK_URL=<url-publica-de-equipo-a>/api/reservas
EQUIPO_A_HEALTH_URL=<url-publica-de-equipo-a>/health
EQUIPO_A_STATUS_URL=<url-publica-de-equipo-a>/api/integracion/status
